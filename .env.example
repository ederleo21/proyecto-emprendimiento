# Copiar a .env antes de levantar:  cp .env.example .env

# ── Django ────────────────────────────────────────────────
SECRET_KEY=dev-inseguro-cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,backend
LOG_LEVEL=INFO
TIME_ZONE=America/Guayaquil

# ── Base de datos ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outreach

# ── Integración con InnoTech ──────────────────────────────
# JWT_SIGNING_KEY debe ser LA MISMA que usa el IAM para firmar; si no, sus
# tokens no validarán acá. Mientras se trabaje aislado, cualquier valor sirve.
JWT_SIGNING_KEY=dev_secret_key_123
JWT_ALGORITHM=HS256

# Secreto compartido para las llamadas entre servicios.
INTERNAL_SERVICE_SECRET=super_secret_token

# URL del IAM. Vacía o inalcanzable = el servicio arranca igual, solo que sin
# poder sincronizar instituciones.
SERVICE_IAM_URL=http://iam-service:8000

# Institución por defecto cuando el Host no resuelve ninguna. Comodidad de
# desarrollo para no tocar el archivo hosts de Windows.
# DEJAR VACÍO EN PRODUCCIÓN.
DEFAULT_TENANT_SCHEMA=itb

# Atajo de desarrollo: mientras no exista pantalla de acceso, autentica
# cualquier petición como un usuario ficticio. Solo funciona con DEBUG=True.
# APAGAR en cuanto haya login.
DEV_AUTH_BYPASS=True

# ── Frontend ──────────────────────────────────────────────
# URL que usa el navegador para llegar al backend.
VITE_API_URL=http://localhost:8100
# Institución que manda el frontend en la cabecera X-Tenant-Schema.
VITE_TENANT_SCHEMA=itb

CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
